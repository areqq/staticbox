# nmap, statically linked, in two variants.
#
#   lean  -- no OpenSSL, no libssh2. The full scanner and NSE with Lua built
#            in, minus the ssl-* and ssh-* scripts. Every target.
#   full  -- cross-builds OpenSSL and libssh2 first, so the ssl-* and ssh-*
#            NSE scripts work. About ten minutes a target, so only where it is
#            actually used.
#
# TOOLCHAIN=bootlin, not zig. This build is proven against Bootlin's gcc
# through six separate failures (see build.sh), and porting a working build to
# a different compiler is a task of its own rather than a precondition for
# having nmap at all. Moving it is one line here when someone does that work.
PKG=nmap
VERSION=7.95
REVISION=1
SOURCE=https://nmap.org/dist/nmap-7.95.tar.bz2
SHA256=e14ab530e47b5afd88f1c8a2bac7f89cd8fe6b478e22d255c5b9bddb7a1c5778
TOOLCHAIN=bootlin
TARGETS=all

VARIANTS='lean full'
# full pulls in OpenSSL and libssh2 and costs about ten minutes per target. On
# the full matrix that is an hour and a half for one release, so it is built
# only where scanning actually happens.
VARIANT_TARGETS_full='armv7-neon mipsel x86_64'

DEPS_full='openssl libssh2'
DEP_SOURCE_openssl=https://github.com/openssl/openssl/releases/download/openssl-3.0.16/openssl-3.0.16.tar.gz
DEP_SHA256_openssl=57e03c50feab5d31b152af2b764f10379aecd8ee92f16c985983ce4a99f7ef86
DEP_SOURCE_libssh2=https://www.libssh2.org/download/libssh2-1.11.0.tar.gz
DEP_SHA256_libssh2=3736161e41e2693324deb38c26cfdc3efe6209d634ba4258db1cecff6a5ad461

SMOKE='--version'
SMOKE_EXPECT='Nmap version'
